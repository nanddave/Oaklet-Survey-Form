# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SURVEY_KMS_KEY_ID=alias/oaklet-survey-hipaa

# Oaklet-Nest Integration
OAKLET_NEST_URL=http://localhost:3001

# DynamoDB
QUESTIONNAIRE_RESPONSES_TABLE=Question_Responses

# JWT Authentication for Nest (Service Account)
NEST_AUTH_EMAIL=survey-form-service@oaklet.com
NEST_AUTH_PASSWORD=SurveyForm2025!Secure

# Survey Configuration
DEFAULT_ORGANIZATION_ID=your-org-id
DEFAULT_PRACTICE_ID=your-practice-id
DEFAULT_SESSION_TYPE=Initial Consultation
CONFIRMATION_PREFIX=OAK
SURVEY_SUCCESS_MESSAGE=Survey completed and appointment scheduled successfully!
SURVEY_NEXT_STEPS=Check your email for appointment confirmation,Complete your profile information before the appointment,An invoice will be sent within 24 hours

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
