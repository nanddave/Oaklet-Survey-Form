# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SURVEY_KMS_KEY_ID=alias/oaklet-survey-hipaa

# Oaklet-Nest Integration
OAKLET_NEST_URL=http://localhost:3001

# DynamoDB
QUESTIONNAIRE_RESPONSES_TABLE=Question_Responses

# JWT Authentication for Nest (Service Account)
NEST_AUTH_EMAIL=your-service-account-email@domain.com
NEST_AUTH_PASSWORD=your-secure-password-here

# Survey Configuration
DEFAULT_ORGANIZATION_ID=your-org-id
DEFAULT_PRACTICE_ID=your-practice-id
DEFAULT_SESSION_TYPE=Initial Consultation
CONFIRMATION_PREFIX=OAK
SURVEY_SUCCESS_MESSAGE=Survey completed and appointment scheduled successfully!
SURVEY_NEXT_STEPS=Check your email for appointment confirmation,Complete your profile information before the appointment,An invoice will be sent within 24 hours

# Default Client Data (for pre-registration)
DEFAULT_CLIENT_FIRST_NAME=Survey
DEFAULT_CLIENT_LAST_NAME=User
DEFAULT_CLIENT_PHONE=
DEFAULT_CLIENT_DOB=
DEFAULT_CLIENT_STREET=
DEFAULT_CLIENT_CITY=
DEFAULT_CLIENT_ZIP=

# Widget Configuration
SURVEY_WIDGET_URL=http://localhost:5174

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration
# REQUIRED: Comma-separated list of allowed origins for CORS
# Empty or whitespace-only entries will be ignored
# Example: http://localhost:5173,http://localhost:5174,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
